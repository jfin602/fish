#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PROJECT="$ROOT/game"
LOGS="$ROOT/artifacts/logs"
mkdir -p "$LOGS"

# This ignored file is a trusted local shell file. GODOT_CMD remains an argument array.
if [[ -f "$ROOT/tools/local.env" ]]; then source "$ROOT/tools/local.env"; fi
if [[ ! ${GODOT_CMD+x} ]]; then GODOT_CMD=("${GODOT_BIN:-godot}"); fi
DOTNET_BIN=${DOTNET_BIN:-dotnet}
if [[ $DOTNET_BIN == */* ]]; then
  export DOTNET_ROOT="$(dirname -- "$DOTNET_BIN")"
  export PATH="$DOTNET_ROOT:$PATH"
fi
if [[ -n ${GODOT_MCP_BRIDGE_URL:-} ]]; then export GODOT_MCP_BRIDGE_URL; fi

usage() {
  echo 'Usage: tools/dev doctor|import|build|check|smoke-world|inspect-pike-encounter|inspect-pike-cover-assets|inspect-pike-cover|inspect-pike-sight|measure-pike-cover|inspect-environment-time|inspect-solar-lighting|inspect-pond-surface|inspect-pond-camera-immersion|inspect-pond-scenery|inspect-ocean-equal-input|inspect-pond-creatures|inspect-pond-atmosphere|inspect-species|inspect-world-catalog|inspect-world-select|editor|run [--display-mode=fullscreen|--display-mode=windowed-fullscreen]|generate-world <seed> <name>|generate-pond <seed> <name>|inspect-candidate <name>|inspect-pond-candidate <name>|smoke-baked-candidate <name>|run-baked-candidate <name>|promote-world <name> <base-name> [--dry-run]|promote-pond <name> <base-name> [--dry-run]|inspect-character-select|collision-debug|prepare-faf-collision|compare compatibility|forward-plus [--effects=off]|measure-atmosphere|measure-visibility|measure-pond-surface|measure-solar-water|inspect-scene <path>|inspect-course|inspect-habitat|inspect-reef|inspect-collision|inspect-terrain|inspect-geology|inspect-generated-geology|inspect-route-fields|inspect-route-anchors|inspect-placement|inspect-dressing|inspect-ambient|inspect-atmosphere|inspect-depth|inspect-water|inspect-faf|inspect-world-compiler|inspect-basin|inspect-shore-field|inspect-geology-sites|compile-world-fixture <seed>|automation-smoke'
}
world_profile="$ROOT/artifacts/world-data"
world_name() { [[ ${1:-} =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]] || { echo 'World name must use lowercase letters, digits and hyphens' >&2; exit 2; }; }
candidate_resource() { echo "user://world-candidates/$1"; }
candidate_disk() { echo "$world_profile/godot/app_userdata/Fish/world-candidates/$1"; }
need_tools() {
  command -v "${GODOT_CMD[0]}" >/dev/null || { echo "Missing Godot .NET executable: ${GODOT_CMD[0]}" >&2; exit 2; }
  command -v "$DOTNET_BIN" >/dev/null || { echo "Missing .NET SDK executable: $DOTNET_BIN" >&2; exit 2; }
}
logged() {
  local name=$1 limit=$2; shift 2
  local log="$LOGS/$name.log" status=0
  timeout --signal=TERM --kill-after=5s "${limit}s" "$@" >"$log" 2>&1 || status=$?
  cat "$log"
  if (( status != 0 )); then echo "$name failed (exit $status; $log)" >&2; return 1; fi
  if grep -E '(^ERROR:|SCRIPT ERROR:|Failed to load|Cannot load|Could not resolve script|FISH_SMOKE_FAILED|SCENE_TOOL_FAILED)' "$log" >&2; then
    echo "$name reported engine errors ($log)" >&2; return 1
  fi
}
do_import() { logged import 120 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --import; }
do_build() { (cd "$PROJECT" && logged build 180 "$DOTNET_BIN" build Fish.csproj --nologo); }
smoke() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/smoke-world.XXXXXX")
  logged smoke 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --smoke
  grep -Fq 'FISH_SMOKE_OK main scene and C# scripts executed' "$LOGS/smoke.log" || { echo 'C# smoke marker missing' >&2; return 1; }
}
scene_tool() { local label=$1; shift; logged "$label" 30 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/scene_tool.gd -- "$@"; }
missing_scene_check() {
  local log="$LOGS/missing-scene.log" status=0
  timeout --signal=TERM --kill-after=5s 30s "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/scene_tool.gd -- inspect res://scenes/does-not-exist.tscn >"$log" 2>&1 || status=$?
  if (( status != 1 )) || ! grep -Fq 'SCENE_TOOL_FAILED scene does not exist:' "$log"; then cat "$log" >&2; echo 'Missing-scene negative check failed' >&2; return 1; fi
  echo 'Expected missing-scene failure confirmed'
}
