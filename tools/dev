  logged faf-runtime 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --faf-runtime-check
  grep -Fq 'FAF_RUNTIME_CHECK_OK environment=38 terrain=6 rock=4 coral=12 plant=8 detail=8 fish=5' "$LOGS/faf-runtime.log" || { echo 'FAF runtime marker missing' >&2; return 1; }
}
