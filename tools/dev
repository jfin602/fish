  profile=$(mktemp -d "$ROOT/artifacts/world-compiler.XXXXXX")
  logged world-compiler 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --world-compiler-check
  grep -Fq 'WORLD_COMPILER_CHECK_OK' "$LOGS/world-compiler.log" || { echo 'World compiler check marker missing' >&2; return 1; }
}
