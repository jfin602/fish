  local profile
  profile=$(mktemp -d "$ROOT/artifacts/generated-geology.XXXXXX")
  logged generated-geology-mesh 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --geology-mesh-check
  grep -Fq 'GEOLOGY_MESH_OK' "$LOGS/generated-geology-mesh.log" || { echo 'Generated geology mesh marker missing' >&2; return 1; }
  logged generated-geology-clearance 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/generated_geology_check.gd
  grep -Fq 'GEOLOGY_CLEARANCE_OK' "$LOGS/generated-geology-clearance.log" || { echo 'Generated geology clearance marker missing' >&2; return 1; }
}
case "${1:-help}" in
  inspect-pike-sight)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pike-sight.XXXXXX")
    logged pike-sight 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/p5_pike_encounter.tscn -- --pike-sight-check
    grep -Fq 'PIKE_SIGHT_CHECK_OK' "$LOGS/pike-sight.log" || { echo 'Pike sight marker missing' >&2; exit 1; }
    ;;
  measure-pike-cover)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pike-native-data.XXXXXX")
    logged pike-cover-native 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/pike_cover_native_probe.gd -- --pike-output="$ROOT/artifacts/pike-cover-native"
    grep -Fq 'PIKE_COVER_NATIVE_SURVEY_OK' "$LOGS/pike-cover-native.log" || { echo 'Pike cover native survey marker missing' >&2; exit 1; }
    ;;
  inspect-pike-cover-assets)
    python3 "$ROOT/tools/asset-factory/check_p5_cover_intake.py"
    python3 "$ROOT/tools/asset-factory/blender/plants/check_pond_stealth_vegetation_001.py"
    python3 "$ROOT/tools/asset-factory/blender/wood/check_pond_wood_002.py"
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pike-cover-assets.XXXXXX")
    logged pike-cover-plants-import 45 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/faf_pond_stealth_vegetation_check.gd
    grep -Fq 'POND_COVER_GODOT_OK assets=13' "$LOGS/pike-cover-plants-import.log" || { echo 'Pike cover plant import marker missing' >&2; exit 1; }
    logged pike-cover-wood-import 45 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/faf_pond_wood_002_check.gd
    grep -Fq 'POND_WOOD_002_GODOT_OK assets=10' "$LOGS/pike-cover-wood-import.log" || { echo 'Pike cover wood import marker missing' >&2; exit 1; }
    ;;
  inspect-pike-cover)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pike-cover.XXXXXX")
    logged pike-cover 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/p5_pike_encounter.tscn -- --pike-cover-check
    grep -Fq 'PIKE_COVER_CHECK_OK' "$LOGS/pike-cover.log" || { echo 'Pike cover marker missing' >&2; exit 1; }
    ;;
  measure-solar-water)
    need_tools
    logged solar-water-pond-probe 180 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/solar_water_probe.gd -- --pond-surface-probe --environment-time-debug
    grep -Fq 'SOLAR_WATER_SAMPLE habitat=pond view=underwater_world hour=0' "$LOGS/solar-water-pond-probe.log" || { echo 'Pond solar water performance marker missing' >&2; exit 1; }
    logged solar-water-ocean-probe 180 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/solar_water_probe.gd -- --environment-time-debug
    grep -Fq 'SOLAR_WATER_SAMPLE habitat=ocean view=underwater_world hour=0' "$LOGS/solar-water-ocean-probe.log" || { echo 'Ocean solar water performance marker missing' >&2; exit 1; }
    ;;
  measure-pond-surface)
    need_tools
    logged pond-surface-probe 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/p11_surface_probe.gd -- --pond-surface-probe
    grep -Fq 'P11_SURFACE_SAMPLE view=underwater_bank' "$LOGS/pond-surface-probe.log" || { echo 'Pond surface performance marker missing' >&2; exit 1; }
    ;;
  inspect-pond-scenery)
    need_tools
    logged pond-scenery 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --pond-scenery-check
    grep -Fq 'POND_SCENERY_CHECK_OK' "$LOGS/pond-scenery.log" || { echo 'Pond scenery marker missing' >&2; exit 1; }
    ;;
  inspect-pond-surface)
    need_tools
    logged pond-surface 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --pond-surface-check
    grep -Fq 'POND_SURFACE_CHECK_OK' "$LOGS/pond-surface.log" || { echo 'Pond surface marker missing' >&2; exit 1; }
    ;;
  inspect-pond-camera-immersion)
    need_tools
    logged pond-camera-immersion 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --pond-camera-immersion-check
    grep -Fq 'POND_CAMERA_IMMERSION_OK' "$LOGS/pond-camera-immersion.log" || { echo 'Pond camera immersion marker missing' >&2; exit 1; }
    ;;
  inspect-ocean-equal-input)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/ocean-equal-input.XXXXXX")
    logged ocean-equal-input 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/atmosphere_movement_check.gd
    grep -Fq 'ATMOSPHERE_MOVEMENT_OK equal-physics-route enabled=disabled' "$LOGS/ocean-equal-input.log" || { echo 'Ocean equal-input marker missing' >&2; exit 1; }
    ;;
  inspect-species)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/species.XXXXXX")
    logged species 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --species-check
    grep -Fq 'SPECIES_CHECK_OK' "$LOGS/species.log" || { echo 'Species check marker missing' >&2; exit 1; }
    ;;
  inspect-world-select)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/world-select.XXXXXX")
    logged world-select 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/world_select.tscn -- --world-select-check
    grep -Fq 'WORLD_SELECT_CHECK_OK' "$LOGS/world-select.log" || { echo 'World Select marker missing' >&2; exit 1; }
    ;;
  inspect-pike-encounter)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pike-encounter.XXXXXX")
    logged pike-encounter 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/world_select.tscn -- --pike-encounter-check
    grep -Fq 'PIKE_ENCOUNTER_CHECK_OK' "$LOGS/pike-encounter.log" || { echo 'Pike encounter marker missing' >&2; exit 1; }
    ;;
  inspect-world-catalog)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/world-catalog.XXXXXX")
    logged world-catalog 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --world-catalog-check
    grep -Fq 'WORLD_CATALOG_CHECK_OK' "$LOGS/world-catalog.log" || { echo 'World catalog marker missing' >&2; exit 1; }
    ;;
  inspect-shore-field)
    need_tools
    logged shore-field 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --shore-field-check
    grep -Fq 'SHORE_FIELD_CHECK_OK' "$LOGS/shore-field.log" || { echo 'Shore field marker missing' >&2; exit 1; }
    ;;
  inspect-geology-sites)
    need_tools
    logged geology-sites 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --geology-site-check
    grep -Fq 'GEOLOGY_SITE_CHECK_OK' "$LOGS/geology-sites.log" || { echo 'Geology site marker missing' >&2; exit 1; }
    ;;
  inspect-route-anchors)
    need_tools
    logged route-anchors 120 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --route-anchor-check
    grep -Fq 'ROUTE_ANCHOR_CHECK_OK' "$LOGS/route-anchors.log" || { echo 'Route anchor marker missing' >&2; exit 1; }
    ;;
  inspect-character-select)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/character-select.XXXXXX")
    logged character-select 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/character_select.tscn -- --character-check
    grep -Fq 'CHARACTER_CHECK_OK' "$LOGS/character-select.log" || { echo 'Character Select marker missing' >&2; exit 1; }
    ;;
  generate-world)
    need_tools
    [[ ${2:-} =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
    world_name "${3:-}"
    (( $# == 3 )) || { usage >&2; exit 2; }
    mkdir -p "$world_profile"
    logged generate-world 300 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--world-generate=$2" "--world-output=$(candidate_resource "$3")"
    grep -Fq 'WORLD_FULL_COMPILE_OK' "$LOGS/generate-world.log" || { echo 'Full-world compile marker missing' >&2; exit 1; }
    ;;
  generate-pond)
    need_tools
    [[ ${2:-} =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
    world_name "${3:-}"
    (( $# == 3 )) || { usage >&2; exit 2; }
    mkdir -p "$world_profile"
    logged generate-pond 300 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--pond-generate=$2" "--world-output=$(candidate_resource "$3")"
    grep -Fq 'WORLD_FULL_COMPILE_OK habitat=pond' "$LOGS/generate-pond.log" || { echo 'Pond compile marker missing' >&2; exit 1; }
    ;;
  inspect-pond-candidate)
    need_tools
    world_name "${2:-}"
    (( $# == 2 )) || { usage >&2; exit 2; }
    mkdir -p "$world_profile"
    logged inspect-pond-candidate 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--pond-inspect=$(candidate_resource "$2")"
    grep -Fq 'POND_WORLD_CHECK_OK' "$LOGS/inspect-pond-candidate.log" || { echo 'Pond inspection marker missing' >&2; exit 1; }
    ;;
  promote-pond)
    need_tools
    world_name "${2:-}"
    world_name "${3:-}"
    [[ $# -eq 3 || ( $# -eq 4 && $4 == --dry-run ) ]] || { usage >&2; exit 2; }
    "$0" inspect-pond-candidate "$2"
    source_dir=$(candidate_disk "$2")
    target_dir="$PROJECT/worlds/base/$3"
    [[ -d "$source_dir" ]] || { echo "Pond candidate missing: $source_dir" >&2; exit 1; }
    [[ ! -e "$target_dir" ]] || { echo "Pond Base World already exists: $target_dir" >&2; exit 1; }
    if (( $# == 4 )); then echo "POND_PROMOTION_DRY_RUN source=$source_dir target=$target_dir"; exit 0; fi
    mkdir -p "$PROJECT/worlds/base"
    cp -a -- "$source_dir" "$target_dir"
    echo "POND_BASE_WORLD_PROMOTED source=$source_dir target=$target_dir"
    ;;
  inspect-candidate|smoke-baked-candidate|run-baked-candidate)
    need_tools
    world_name "${2:-}"
    (( $# == 2 )) || { usage >&2; exit 2; }
    mkdir -p "$world_profile"
    case "$1" in
      inspect-candidate) logged inspect-candidate 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--world-package=$(candidate_resource "$2")" --world-inspect ;;
      smoke-baked-candidate) logged smoke-baked-candidate 120 env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--world-package=$(candidate_resource "$2")" --smoke ;;
      run-baked-candidate) exec env XDG_DATA_HOME="$world_profile" "${GODOT_CMD[@]}" --path "$PROJECT" --scene res://scenes/main.tscn -- "--world-package=$(candidate_resource "$2")" ;;
    esac
    grep -Fq 'WORLD_BAKED_LOAD_OK' "$LOGS/$1.log" || { echo 'Baked load marker missing' >&2; exit 1; }
    ;;
  promote-world)
    need_tools
    world_name "${2:-}"
    world_name "${3:-}"
    [[ $# -eq 3 || ( $# -eq 4 && $4 == --dry-run ) ]] || { usage >&2; exit 2; }
    "$0" inspect-candidate "$2"
    source_dir=$(candidate_disk "$2")
    target_dir="$PROJECT/worlds/base/$3"
    [[ -d "$source_dir" ]] || { echo "Candidate missing: $source_dir" >&2; exit 1; }
    [[ ! -e "$target_dir" ]] || { echo "Base World already exists: $target_dir" >&2; exit 1; }
    if (( $# == 4 )); then echo "PROMOTION_DRY_RUN source=$source_dir target=$target_dir"; exit 0; fi
    mkdir -p "$PROJECT/worlds/base"
    cp -a -- "$source_dir" "$target_dir"
    echo "BASE_WORLD_PROMOTED source=$source_dir target=$target_dir"
    ;;
  smoke-world) need_tools; smoke ;;
  doctor)
    need_tools
    version=$("${GODOT_CMD[@]}" --version)
    echo "Godot: $version (${GODOT_CMD[*]})"
    [[ $version == *mono* ]] || { echo 'Godot executable lacks .NET support' >&2; exit 2; }
    echo "dotnet: $DOTNET_BIN; selected SDK: $(cd "$PROJECT" && "$DOTNET_BIN" --version)"
    echo "Project: $PROJECT; bridge: ${GODOT_MCP_BRIDGE_URL:-unset}; display: ${DISPLAY:-unset}; Wayland: ${WAYLAND_DISPLAY:-unset}"
    for required in project.godot Fish.csproj global.json scenes/main.tscn; do
      [[ -f "$PROJECT/$required" ]] || { echo "Fish project file missing: $PROJECT/$required" >&2; exit 2; }
    done
    echo 'Fish project files: ready (project, C# target, SDK pin, main scene)'
    if [[ -f "$PROJECT/addons/godot_mcp/plugin.cfg" ]]; then
      echo "MCP addon: $(sed -n 's/^version="\(.*\)"/\1/p' "$PROJECT/addons/godot_mcp/plugin.cfg")"
    fi
    ;;
  import) need_tools; do_import ;;
  build) need_tools; do_build ;;
  inspect-environment-time)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/environment-time.XXXXXX")
    logged environment-time 45 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --environment-time-check --environment-hour=6 --environment-speed=10
    grep -Fq 'ENVIRONMENT_TIME_CHECK_OK debug=False' "$LOGS/environment-time.log" || { echo 'Environment time isolation marker missing' >&2; exit 1; }
    logged environment-time-debug 45 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --environment-time-check --environment-time-debug --environment-hour=6 --environment-speed=10
    grep -Fq 'ENVIRONMENT_TIME_CHECK_OK debug=True' "$LOGS/environment-time-debug.log" || { echo 'Environment time debug marker missing' >&2; exit 1; }
    ;;
  inspect-solar-lighting)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/solar-lighting.XXXXXX")
    logged solar-lighting-ocean 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --environment-time-debug --solar-lighting-check
    grep -Fq 'SOLAR_LIGHTING_CHECK_OK habitat=ocean' "$LOGS/solar-lighting-ocean.log" || { echo 'Ocean solar lighting marker missing' >&2; exit 1; }
    logged solar-lighting-pond 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --environment-time-debug --solar-lighting-pond-check
    grep -Fq 'SOLAR_LIGHTING_CHECK_OK habitat=pond' "$LOGS/solar-lighting-pond.log" || { echo 'Pond solar lighting marker missing' >&2; exit 1; }
    ;;
  inspect-pond-creatures)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pond-creatures.XXXXXX")
    logged pond-creatures 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --pond-creature-check
    grep -Fq 'POND_CREATURE_CHECK_OK fish=5 stages=25 creatures=3 insects=4 ambient=12' "$LOGS/pond-creatures.log" || { echo 'Pond creature integration marker missing' >&2; exit 1; }
    ;;
  inspect-pond-atmosphere)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/pond-atmosphere.XXXXXX")
    logged pond-atmosphere 120 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --pond-atmosphere-check --environment-time-debug
    grep -Fq 'POND_ATMOSPHERE_CHECK_OK' "$LOGS/pond-atmosphere.log" || { echo 'Pond atmosphere marker missing' >&2; exit 1; }
    ;;
  check)
    need_tools
    do_import
    do_build
    smoke
    scene_tool automation-smoke automation-smoke
    missing_scene_check
    camera_scene_check
    animation_scene_check
    faf_runtime_check
    "$0" inspect-route-fields
    "$0" inspect-placement
    ;;
  editor) need_tools; exec "${GODOT_CMD[@]}" --editor --path "$PROJECT" ;;
  run)
    display_arg=()
    if (( $# > 2 )); then usage >&2; exit 2; fi
    if (( $# == 2 )); then
      case "$2" in
        --display-mode=fullscreen|--display-mode=windowed-fullscreen) display_arg=(-- "$2") ;;
        *) usage >&2; echo "Unsupported display mode option: $2" >&2; exit 2 ;;
      esac
    fi
    need_tools
    do_build
    exec "${GODOT_CMD[@]}" --path "$PROJECT" "${display_arg[@]}"
    ;;
  collision-debug)
    need_tools
    do_build
    exec "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --debug-collisions
    ;;
  prepare-faf-collision)
    need_tools
    do_import
    do_build
    logged prepare-faf-geology-collision 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/prepare_faf_collision.gd
    logged prepare-faf-terrain-collision 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/prepare_faf_terrain_collision.gd -- --prepare-faf-terrain-collision
    ;;
  compare)
    (( $# == 2 || $# == 3 )) || { usage >&2; exit 2; }
    case "$2" in
      compatibility) renderer=gl_compatibility ;;
      forward-plus) renderer=forward_plus ;;
      *) usage >&2; exit 2 ;;
    esac
    effect_arg=()
    if (( $# == 3 )); then
      [[ $3 == --effects=off ]] || { usage >&2; exit 2; }
      effect_arg=(-- --comparison-effects=off)
    fi
    need_tools
    do_build
    exec "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method "$renderer" --scene res://scenes/renderer_comparison.tscn "${effect_arg[@]}"
    ;;
  measure-atmosphere)
    need_tools
    logged atmosphere-ab 180 "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/atmosphere_ab_probe.gd
    grep -Fq 'ATMOSPHERE_AB_OK' "$LOGS/atmosphere-ab.log" || { echo 'Atmosphere A/B marker missing' >&2; exit 1; }
    ;;
  measure-visibility)
    need_tools
    logged visibility-ab 180 "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/visibility_ab_probe.gd
    grep -Fq 'VISIBILITY_AB_OK' "$LOGS/visibility-ab.log" || { echo 'Visibility A/B marker missing' >&2; exit 1; }
    ;;
  inspect-scene)
    need_tools
    [[ -n ${2:-} ]] || { usage >&2; exit 2; }
    path=$2
    if [[ $path == "$PROJECT/"* ]]; then path="res://${path#"$PROJECT/"}";
    elif [[ $path != res://* ]]; then path="res://${path#game/}"; fi
    scene_tool inspect-scene inspect "$path"
    ;;
  inspect-course)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/course-check.XXXXXX")
    logged course-check 30 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/course_check.gd
    grep -Fq 'COURSE_CHECK_OK' "$LOGS/course-check.log" || { echo 'Course assertion marker missing' >&2; exit 1; }
    ;;
  inspect-habitat) need_tools; habitat_check ;;
  inspect-reef) need_tools; reef_check ;;
  inspect-terrain) need_tools; terrain_world_check ;;
  inspect-geology) need_tools; geology_check ;;
  inspect-generated-geology) need_tools; generated_geology_check ;;
  inspect-route-fields)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/route-fields.XXXXXX")
    logged route-fields 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --route-field-check
    grep -Fq 'ROUTE_FIELD_CHECK_OK' "$LOGS/route-fields.log" || { echo 'Route/field marker missing' >&2; exit 1; }
    ;;
  inspect-placement)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/placement-check.XXXXXX")
    logged placement-check 240 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --placement-check
    grep -Fq 'WORLD_PLACEMENT_CHECK_OK' "$LOGS/placement-check.log" || { echo 'Placement marker missing' >&2; exit 1; }
    ;;
  inspect-collision) need_tools; collision_check ;;
  inspect-dressing) need_tools; dressing_check ;;
  inspect-ambient) need_tools; ambient_check ;;
  inspect-atmosphere) need_tools; atmosphere_check ;;
  inspect-depth) need_tools; depth_check ;;
  inspect-water) need_tools; water_reaction_check ;;
  inspect-faf) need_tools; faf_runtime_check ;;
  inspect-world-compiler) need_tools; world_compiler_check ;;
  inspect-basin)
    need_tools
    profile=$(mktemp -d "$ROOT/artifacts/basin-check.XXXXXX")
    logged basin-check 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --basin-check
    grep -Fq 'BASIN_CHECK_OK' "$LOGS/basin-check.log" || { echo 'Basin assertion marker missing' >&2; exit 1; }
    ;;
  compile-world-fixture)
    need_tools
    [[ ${2:-} =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
    profile="$ROOT/artifacts/world-data"
    mkdir -p "$profile"
    logged compile-world-fixture 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--compile-world-fixture=$2"
    grep -Fq 'WORLD_COMPILE_OK' "$LOGS/compile-world-fixture.log" || { echo 'World fixture compile marker missing' >&2; return 1; }
    ;;
  automation-smoke) need_tools; scene_tool automation-smoke automation-smoke ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
