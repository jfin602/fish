#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PROJECT="$ROOT/game"
LOGS="$ROOT/artifacts/logs"
mkdir -p "$LOGS"

# This ignored file is a trusted local shell file. GODOT_CMD remains an argument array.
if [[ -f "$ROOT/tools/local.env" ]]; then source "$ROOT/tools/local.env"; fi
if [[ ! ${GODOT_CMD+x} ]]; then GODOT_CMD=("${GODOT_BIN:-godot}"); fi
DOTNET_BIN=${DOTNET_BIN:-dotnet}
if [[ $DOTNET_BIN == */* ]]; then
  export DOTNET_ROOT="$(dirname -- "$DOTNET_BIN")"
  export PATH="$DOTNET_ROOT:$PATH"
fi
if [[ -n ${GODOT_MCP_BRIDGE_URL:-} ]]; then export GODOT_MCP_BRIDGE_URL; fi

usage() {
  echo 'Usage: tools/dev doctor|import|build|check|editor|run [--display-mode=fullscreen|--display-mode=windowed-fullscreen]|collision-debug|prepare-faf-collision|compare compatibility|forward-plus [--effects=off]|measure-atmosphere|measure-visibility|inspect-scene <path>|inspect-course|inspect-habitat|inspect-reef|inspect-collision|inspect-terrain|inspect-geology|inspect-dressing|inspect-ambient|inspect-atmosphere|inspect-depth|inspect-water|inspect-faf|inspect-world-compiler|compile-world-fixture <seed>|automation-smoke'
}
need_tools() {
  command -v "${GODOT_CMD[0]}" >/dev/null || { echo "Missing Godot .NET executable: ${GODOT_CMD[0]}" >&2; exit 2; }
  command -v "$DOTNET_BIN" >/dev/null || { echo "Missing .NET SDK executable: $DOTNET_BIN" >&2; exit 2; }
}
logged() {
  local name=$1 limit=$2; shift 2
  local log="$LOGS/$name.log" status=0
  timeout --signal=TERM --kill-after=5s "${limit}s" "$@" >"$log" 2>&1 || status=$?
  cat "$log"
  if (( status != 0 )); then echo "$name failed (exit $status; $log)" >&2; return 1; fi
  if grep -E '(^ERROR:|SCRIPT ERROR:|Failed to load|Cannot load|Could not resolve script|FISH_SMOKE_FAILED|SCENE_TOOL_FAILED)' "$log" >&2; then
    echo "$name reported engine errors ($log)" >&2; return 1
  fi
}
do_import() { logged import 120 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --import; }
do_build() { (cd "$PROJECT" && logged build 180 "$DOTNET_BIN" build Fish.csproj --nologo); }
smoke() {
  logged smoke 30 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --smoke
  grep -Fq 'FISH_SMOKE_OK main scene and C# scripts executed' "$LOGS/smoke.log" || { echo 'C# smoke marker missing' >&2; return 1; }
}
scene_tool() { local label=$1; shift; logged "$label" 30 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/scene_tool.gd -- "$@"; }
missing_scene_check() {
  local log="$LOGS/missing-scene.log" status=0
  timeout --signal=TERM --kill-after=5s 30s "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/scene_tool.gd -- inspect res://scenes/does-not-exist.tscn >"$log" 2>&1 || status=$?
  if (( status != 1 )) || ! grep -Fq 'SCENE_TOOL_FAILED scene does not exist:' "$log"; then cat "$log" >&2; echo 'Missing-scene negative check failed' >&2; return 1; fi
  echo 'Expected missing-scene failure confirmed'
}
input_lifecycle_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/input-lifecycle.XXXXXX")
  logged input-lifecycle 30 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/input_lifecycle_check.gd
  grep -Fq 'INPUT_LIFECYCLE_OK' "$LOGS/input-lifecycle.log" || { echo 'Input lifecycle marker missing' >&2; return 1; }
}
camera_scene_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/camera-scene.XXXXXX")
  logged camera-scene 30 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/camera_scene_check.gd
  grep -Fq 'CAMERA_SCENE_OK' "$LOGS/camera-scene.log" || { echo 'Camera scene marker missing' >&2; return 1; }
}
animation_scene_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/animation-scene.XXXXXX")
  logged animation-scene 30 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/animation_scene_check.gd
  grep -Fq 'ANIMATION_SCENE_OK' "$LOGS/animation-scene.log" || { echo 'Animation scene marker missing' >&2; return 1; }
}
habitat_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/habitat-check.XXXXXX")
  logged habitat-check 30 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/habitat_check.gd
  grep -Fq 'HABITAT_CHECK_OK' "$LOGS/habitat-check.log" || { echo 'Habitat assertion marker missing' >&2; return 1; }
}
reef_check() {
  logged reef-check 45 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/reef_check.gd
  grep -Fq 'REEF_CHECK_OK' "$LOGS/reef-check.log" || { echo 'Reef assertion marker missing' >&2; return 1; }
}
terrain_world_check() {
  logged terrain-world 45 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/faf_terrain_world_check.gd
  grep -Fq 'FAF_TERRAIN_WORLD_OK' "$LOGS/terrain-world.log" || { echo 'FAF terrain world marker missing' >&2; return 1; }
}
geology_check() {
  logged geology-check 45 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/faf_geology_check.gd
  grep -Fq 'FAF_GEOLOGY_OK' "$LOGS/geology-check.log" || { echo 'FAF geology marker missing' >&2; return 1; }
}
collision_check() {
  logged world-collision 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/world_collision_check.gd
  grep -Fq 'WORLD_COLLISION_OK' "$LOGS/world-collision.log" || { echo 'World collision marker missing' >&2; return 1; }
}
dressing_check() {
  logged dressing-check 45 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/faf_reef_dressing_check.gd
  grep -Fq 'FAF_DRESSING_OK variants=28 clusters=28 placements=295' "$LOGS/dressing-check.log" || { echo 'FAF dressing marker missing' >&2; return 1; }
}
ambient_check() {
  logged ambient-check 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/faf_ambient_check.gd
  grep -Fq 'FAF_AMBIENT_OK schools=9 fish=31' "$LOGS/ambient-check.log" || { echo 'FAF ambient marker missing' >&2; return 1; }
}
atmosphere_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/atmosphere-check.XXXXXX")
  logged atmosphere-check 45 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/atmosphere_check.gd
  grep -Fq 'ATMOSPHERE_CHECK_OK' "$LOGS/atmosphere-check.log" || { echo 'Atmosphere assertion marker missing' >&2; return 1; }
  logged atmosphere-movement 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/atmosphere_movement_check.gd
  grep -Fq 'ATMOSPHERE_MOVEMENT_OK' "$LOGS/atmosphere-movement.log" || { echo 'Atmosphere movement marker missing' >&2; return 1; }
}
depth_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/depth-check.XXXXXX")
  logged depth-check 45 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --depth-check
  grep -Fq 'DEPTH_CHECK_OK' "$LOGS/depth-check.log" || { echo 'Depth assertion marker missing' >&2; return 1; }
}
water_reaction_check() {
  logged water-reaction 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/water_reaction_check.gd
  grep -Fq 'WATER_REACTION_OK' "$LOGS/water-reaction.log" || { echo 'Water reaction marker missing' >&2; return 1; }
}
faf_runtime_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/faf-runtime.XXXXXX")
  logged faf-runtime 90 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --faf-runtime-check
  grep -Fq 'FAF_RUNTIME_CHECK_OK environment=38 terrain=6 rock=4 coral=12 plant=8 detail=8 fish=5' "$LOGS/faf-runtime.log" || { echo 'FAF runtime marker missing' >&2; return 1; }
}
world_compiler_check() {
  local profile
  profile=$(mktemp -d "$ROOT/artifacts/world-compiler.XXXXXX")
  logged world-compiler 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- --world-compiler-check
  grep -Fq 'WORLD_COMPILER_CHECK_OK' "$LOGS/world-compiler.log" || { echo 'World compiler check marker missing' >&2; return 1; }
}
case "${1:-help}" in
  doctor)
    need_tools
    version=$("${GODOT_CMD[@]}" --version)
    echo "Godot: $version (${GODOT_CMD[*]})"
    [[ $version == *mono* ]] || { echo 'Godot executable lacks .NET support' >&2; exit 2; }
    echo "dotnet: $DOTNET_BIN; selected SDK: $(cd "$PROJECT" && "$DOTNET_BIN" --version)"
    echo "Project: $PROJECT; bridge: ${GODOT_MCP_BRIDGE_URL:-unset}; display: ${DISPLAY:-unset}; Wayland: ${WAYLAND_DISPLAY:-unset}"
    for required in project.godot Fish.csproj global.json scenes/main.tscn; do
      [[ -f "$PROJECT/$required" ]] || { echo "Fish project file missing: $PROJECT/$required" >&2; exit 2; }
    done
    echo 'Fish project files: ready (project, C# target, SDK pin, main scene)'
    if [[ -f "$PROJECT/addons/godot_mcp/plugin.cfg" ]]; then
      echo "MCP addon: $(sed -n 's/^version="\(.*\)"/\1/p' "$PROJECT/addons/godot_mcp/plugin.cfg")"
    fi
    ;;
  import) need_tools; do_import ;;
  build) need_tools; do_build ;;
  check) need_tools; do_import; do_build; smoke; scene_tool automation-smoke automation-smoke; missing_scene_check; input_lifecycle_check; camera_scene_check; animation_scene_check; habitat_check; reef_check; terrain_world_check; geology_check; collision_check; dressing_check; ambient_check; atmosphere_check; water_reaction_check ;;
  editor) need_tools; exec "${GODOT_CMD[@]}" --editor --path "$PROJECT" ;;
  run)
    display_arg=()
    if (( $# > 2 )); then usage >&2; exit 2; fi
    if (( $# == 2 )); then
      case "$2" in
        --display-mode=fullscreen|--display-mode=windowed-fullscreen) display_arg=(-- "$2") ;;
        *) usage >&2; echo "Unsupported display mode option: $2" >&2; exit 2 ;;
      esac
    fi
    need_tools
    do_build
    exec "${GODOT_CMD[@]}" --path "$PROJECT" "${display_arg[@]}"
    ;;
  collision-debug)
    need_tools
    do_build
    exec "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --debug-collisions
    ;;
  prepare-faf-collision)
    need_tools
    do_import
    do_build
    logged prepare-faf-geology-collision 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/prepare_faf_collision.gd
    logged prepare-faf-terrain-collision 60 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/prepare_faf_terrain_collision.gd -- --prepare-faf-terrain-collision
    ;;
  compare)
    (( $# == 2 || $# == 3 )) || { usage >&2; exit 2; }
    case "$2" in
      compatibility) renderer=gl_compatibility ;;
      forward-plus) renderer=forward_plus ;;
      *) usage >&2; exit 2 ;;
    esac
    effect_arg=()
    if (( $# == 3 )); then
      [[ $3 == --effects=off ]] || { usage >&2; exit 2; }
      effect_arg=(-- --comparison-effects=off)
    fi
    need_tools
    do_build
    exec "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method "$renderer" --scene res://scenes/renderer_comparison.tscn "${effect_arg[@]}"
    ;;
  measure-atmosphere)
    need_tools
    logged atmosphere-ab 180 "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/atmosphere_ab_probe.gd
    grep -Fq 'ATMOSPHERE_AB_OK' "$LOGS/atmosphere-ab.log" || { echo 'Atmosphere A/B marker missing' >&2; exit 1; }
    ;;
  measure-visibility)
    need_tools
    logged visibility-ab 180 "${GODOT_CMD[@]}" --path "$PROJECT" --rendering-method forward_plus --script res://dev/visibility_ab_probe.gd
    grep -Fq 'VISIBILITY_AB_OK' "$LOGS/visibility-ab.log" || { echo 'Visibility A/B marker missing' >&2; exit 1; }
    ;;
  inspect-scene)
    need_tools
    [[ -n ${2:-} ]] || { usage >&2; exit 2; }
    path=$2
    if [[ $path == "$PROJECT/"* ]]; then path="res://${path#"$PROJECT/"}";
    elif [[ $path != res://* ]]; then path="res://${path#game/}"; fi
    scene_tool inspect-scene inspect "$path"
    ;;
  inspect-course)
    need_tools
    logged course-check 30 "${GODOT_CMD[@]}" --headless --path "$PROJECT" --script res://dev/course_check.gd
    grep -Fq 'COURSE_CHECK_OK' "$LOGS/course-check.log" || { echo 'Course assertion marker missing' >&2; exit 1; }
    ;;
  inspect-habitat) need_tools; habitat_check ;;
  inspect-reef) need_tools; reef_check ;;
  inspect-terrain) need_tools; terrain_world_check ;;
  inspect-geology) need_tools; geology_check ;;
  inspect-collision) need_tools; collision_check ;;
  inspect-dressing) need_tools; dressing_check ;;
  inspect-ambient) need_tools; ambient_check ;;
  inspect-atmosphere) need_tools; atmosphere_check ;;
  inspect-depth) need_tools; depth_check ;;
  inspect-water) need_tools; water_reaction_check ;;
  inspect-faf) need_tools; faf_runtime_check ;;
  inspect-world-compiler) need_tools; world_compiler_check ;;
  compile-world-fixture)
    need_tools
    [[ ${2:-} =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
    profile="$ROOT/artifacts/world-data"
    mkdir -p "$profile"
    logged compile-world-fixture 60 env XDG_DATA_HOME="$profile" "${GODOT_CMD[@]}" --headless --path "$PROJECT" --scene res://scenes/main.tscn -- "--compile-world-fixture=$2"
    grep -Fq 'WORLD_COMPILE_OK' "$LOGS/compile-world-fixture.log" || { echo 'World fixture compile marker missing' >&2; return 1; }
    ;;
  automation-smoke) need_tools; scene_tool automation-smoke automation-smoke ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
